NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — bypasses RLS. Server-only. Used by Server Actions
# that need elevated access (push subscription writes/reads).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Web push (VAPID). Generate with `pnpm dlx web-push generate-vapid-keys`.
# The public key is exposed to the browser; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:hvc.cricket@gmail.com

# App environment marker — drives the home-screen icon theme so dev
# and prod PWAs are visually distinct on the same phone. Anything
# other than `dev` renders the prod (dark grey HVC) icon.
NEXT_PUBLIC_APP_ENV=prod
